"UnlitGeneric"
{
	"$basetexture" "animations/duane_dance"
	"$nolod" 1
	"$translucent" 1
	"$vertexalpha" 1
	"$vertexcolor" 1
	
	"Proxies"
   {
      "AnimatedTexture"
      {
         "animatedtexturevar" "$basetexture"
         "animatedtextureframenumvar" "$frame"
         "animatedtextureframerate" "14"
      }
   }
}